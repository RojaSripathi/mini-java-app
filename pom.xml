<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Spring Boot 3.2.5 parent BOM:
        - Requires Java 17+ (fully supports Java 21)
        - Migrates from javax.* to jakarta.* (Jakarta EE 10)
        - Uses Spring Framework 6.x, Hibernate 6.x
        - Replaces the previous Spring Boot 2.7.0 parent which was NOT compatible with Java 21
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.test</groupId>
    <artifactId>mini-java-app</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <!--
            Updated from Java 11 to Java 21.
            Spring Boot 3.2.x requires Java 17+ and fully supports Java 21.
        -->
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!--
            Spring Boot Web Starter.
            Version is managed by the Spring Boot parent BOM (3.2.5).
            Spring Boot 3.x uses Jakarta EE 10 (jakarta.* namespace).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            MySQL Connector/J 8.2.0:
            - Updated from mysql:mysql-connector-java (deprecated artifact) to
              com.mysql:mysql-connector-j (new artifact ID from MySQL 8.0.31+)
            - 8.2.0 provides better Java 21 support and is the recommended version
              for Spring Boot 3.x projects
            - Compatible with Jakarta EE 10
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.2.0</version>
        </dependency>

        <!--
            Spring Boot Test Starter for JUnit 5 (Jupiter) support.
            Spring Boot 3.x includes JUnit 5 by default via this starter.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Updated maven-compiler-plugin from 3.8.1 to 3.13.0.
                - 3.8.1 does NOT fully support Java 21 features (virtual threads,
                  pattern matching for switch, record patterns, sequenced collections).
                - 3.11.0+ is required for Java 21 compatibility.
                - 3.13.0 is the latest stable version with full Java 21 support.
                Note: The Spring Boot parent BOM also configures this plugin,
                but we override here to ensure the latest version is used.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                    <release>21</release>
                </configuration>
            </plugin>

            <!--
                maven-surefire-plugin 3.2.5 for Java 21 test compatibility.
                - Older surefire versions may fail on Java 21 due to module system
                  restrictions and virtual thread support.
                - 3.2.5 fully supports JUnit 5 (Jupiter) and Java 21.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <!--
                Spring Boot Maven Plugin for executable JAR packaging.
                Version is managed by the Spring Boot parent BOM (3.2.5).
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
